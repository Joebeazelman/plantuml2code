with "hsm_runtime";

project History_Test is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("history_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end History_Test;
