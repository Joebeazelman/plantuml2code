project Class_Test is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("class_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX",
         "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Class_Test;
