@startuml Zoo
package Animals {
  abstract class Animal {
    #name : String
    +Speak() : void
    +{abstract} Move()
  }
  class Dog {
    +Fetch()
    +Move()
    +Name() : String
  }
  interface Pet {
    +Name() : String
  }
  enum Color {
    Red
    Green
    Blue
  }
}
class Toy
Animal <|-- Dog
Pet <|.. Dog
Dog "1" *-- "many" Toy : owns
Dog --> Color : has
@enduml
