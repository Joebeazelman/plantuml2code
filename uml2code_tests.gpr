with "aunit";
with "uml2code";

project Uml2Code_Tests is
   for Source_Dirs use ("tests/unit");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Main use ("test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX",
         "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Uml2Code_Tests;
