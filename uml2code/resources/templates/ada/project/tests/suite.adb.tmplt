with AUnit.Test_Cases;
with AUnit.Test_Suites;  use AUnit.Test_Suites;
@@TABLE@@
with @_CASE_PACKAGE_@;
@@END_TABLE@@

function @_SUITE_NAME_@ return Access_Test_Suite is
   Result : constant Access_Test_Suite := new Test_Suite;
@@TABLE@@
   type Ref_@_TEST_INDEX_@ is access Test_Case'Class;
   T_@_TEST_INDEX_@ : Ref_@_TEST_INDEX_@ :=
     new @_CASE_PACKAGE_@.Case_Type;
@@END_TABLE@@
begin
@@TABLE@@
   Add_Test (Result, T_@_TEST_INDEX_@);
@@END_TABLE@@
   return Result;
end @_SUITE_NAME_@;
