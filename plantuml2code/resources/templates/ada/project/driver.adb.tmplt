--  driver.adb -- starter driver for @_MACHINE_NAME_@.
--  Edit to drive your machine with real events.

with Ada.Text_IO;              use Ada.Text_IO;
with State_Machine.Tracing;
with @_MACHINE_NAME_@;

procedure Driver is
   use @_MACHINE_NAME_@.Base;

   procedure Print_Trace (Msg : String) is
   begin
      Put_Line (Msg);
   end Print_Trace;

   M : @_MACHINE_NAME_@.Machine;
begin
   State_Machine.Tracing.Set_Tracer (Print_Trace'Unrestricted_Access);
   Start (M);
   Put_Line ("Initial state: " & Current_State (M)'Image);

   --  TODO: drive the machine, e.g.
   --     Step (M, @_MACHINE_NAME_@.<Event>);
   --     Put_Line (Current_State (M)'Image);
end Driver;
