#!/usr/bin/env bash
# setup.sh -- generated by plantuml2code
# Creates an Alire project for @_MACHINE_NAME_@ and builds it.
#
# Safe to re-run: existing alire.toml and *.gpr are preserved.

set -euo pipefail
cd "$(dirname "$0")"

PROJECT_NAME="@_PROJECT_NAME_@"
DRIVER="driver"

if ! command -v alr >/dev/null 2>&1; then
  echo "error: alr not found on PATH" >&2
  echo "install Alire from https://alire.ada.dev/" >&2
  exit 1
fi

if [ ! -f alire.toml ]; then
  cat > alire.toml <<TOML
name = "$PROJECT_NAME"
description = "Generated from @_MACHINE_NAME_@"
version = "0.1.0"
authors = ["plantuml2code"]
maintainers = ["plantuml2code <noreply@example.com>"]
maintainers-logins = ["plantuml2code"]
licenses = "MIT OR Apache-2.0 WITH LLVM-exception"
executables = ["$DRIVER"]

[build-switches]
"*".ada_version = "ada2022"
"*".style_checks = "No"
"*".optimization = "debug"
TOML
  echo "wrote alire.toml"
fi

if [ ! -f "$PROJECT_NAME.gpr" ]; then
  cat > "$PROJECT_NAME.gpr" <<GPR
project $PROJECT_NAME is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("$DRIVER.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end $PROJECT_NAME;
GPR
  echo "wrote $PROJECT_NAME.gpr"
fi

echo
echo "==> alr build"
alr build

echo
echo "==> ./bin/$DRIVER"
./bin/$DRIVER
