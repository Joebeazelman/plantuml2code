library project PlantUML_Parser is
   for Library_Name use "plantuml_parser";
   for Library_Dir use "lib";
   for Object_Dir use "obj";
   for Source_Dirs use ("src");

   for Library_Interface use
     ("UML",
      "UML.Model",
      "UML.Model.Queries",
      "PlantUML",
      "PlantUML.Tokens",
      "PlantUML.States",
      "PlantUML.Classes");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX",
         "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;

   package Install is
      for Artifacts (".") use ("src");
   end Install;
end PlantUML_Parser;
