with "uml2code";

project Golden_Tests is
   for Source_Dirs use ("tests");
   for Object_Dir use "obj/golden_tests";
   for Exec_Dir use "bin";
   for Main use ("golden_test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX",
         "-gnata", "-gnatwa");
   end Compiler;
end Golden_Tests;
