---------------------------------------------------------------------
--  {{ PACKAGE_NAME | ada_ident }}
{{ TITLE_LINE }}
{% for comment_line in comment_lines %}
{{ comment_line.text }}
{% endfor %}
---------------------------------------------------------------------

{% if needs_unbounded %}
with Ada.Strings.Unbounded;  use Ada.Strings.Unbounded;
{% endif %}
{% if has_vector_instantiations %}
with Ada.Containers.Vectors;
{% endif %}

package {{ PACKAGE_NAME | ada_ident }} is

{% for enum in enums %}
{% for comment_line in enum.comment_lines %}
   {{ comment_line.text }}
{% endfor %}
   type {{ enum.name | ada_ident }} is ({% for lit in enum.literals %}{{ lit | ada_ident }}{% if not loop.last %}, {% endif %}{% endfor %});

{% endfor %}
{% for iface in interfaces %}
{% for comment_line in iface.comment_lines %}
   {{ comment_line.text }}
{% endfor %}
   type {{ iface.name | ada_ident }} is limited interface;

{% endfor %}
{% for klass in classes %}
{% for comment_line in klass.comment_lines %}
   {{ comment_line.text }}
{% endfor %}
   type {{ klass.name | ada_ident }} is{% if klass.is_abstract %} abstract{% endif %}{% if klass.has_parent %} new {{ klass.parent | ada_ident }}{% endif %}{% if klass.has_parent and klass.has_interface %} and {{ klass.first_interface | ada_ident }}{% endif %}{% if klass.has_interface and not klass.has_parent %} new {{ klass.first_interface | ada_ident }}{% endif %}{% if not klass.has_parent and not klass.has_interface %} tagged{% endif %}{% if klass.has_parent or klass.has_interface %} with{% endif %}{% if klass.has_fields %} record
{% for field in klass.field_lines %}
      {{ field }}
{% endfor %}
   end record;{% endif %}{% if not klass.has_fields %} null record;{% endif %}

{% for method in klass.methods %}
{% if method.has_return_type %}
   function {{ method.name | ada_ident }} (Self : in out {{ klass.name | ada_ident }}) return {{ method.return_type | ada_type }};
{% endif %}
{% if not method.has_return_type %}
   procedure {{ method.name | ada_ident }} (Self : in out {{ klass.name | ada_ident }});
{% endif %}
{% endfor %}

{% endfor %}
{% for vec in vector_instantiations %}
   type {{ vec.element_type | ada_ident }}_Access is access all {{ vec.element_type | ada_ident }}'Class;

   package {{ vec.vector_name | ada_ident }} is new Ada.Containers.Vectors
     (Index_Type   => Positive,
      Element_Type => {{ vec.element_type | ada_ident }}_Access);

{% endfor %}

end {{ PACKAGE_NAME | ada_ident }};
