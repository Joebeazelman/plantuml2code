with "aunit";

project @_TESTS_PROJECT_@ is
   for Source_Dirs use ("src", "tests/test");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Main use ("test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end @_TESTS_PROJECT_@;
