#!/bin/bash
# Auto-generated Alire project setup for {{MACHINE_NAME}}
# Generated on {{GENERATION_DATE}}

set -e

PROJECT_NAME="{{PROJECT_NAME}}"
MACHINE_NAME="{{MACHINE_NAME}}"
CRATE_VERSION="0.1.0"

echo "Setting up Alire crate: $PROJECT_NAME ($CRATE_VERSION)..."

# Create alire.toml with valid email format
cat > alire.toml << ALIRE_TOML
name = "$PROJECT_NAME"
description = "State machine generated from PlantUML"
version = "$CRATE_VERSION"

authors = ["Generated by uml2code"]
maintainers = ["maintainer <maintainer@example.com>"]
maintainers-logins = ["generated"]

tags = ["state-machine", "generated", "plantuml"]

project-files = ["$PROJECT_NAME.gpr"]
executables = ["$PROJECT_NAME"]
ALIRE_TOML

# Create minimal project file
cat > $PROJECT_NAME.gpr << GPR
project $PROJECT_NAME is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("driver.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnatwa", "-gnatVa");
   end Compiler;

end $PROJECT_NAME;
GPR

# Move driver.adb from tests/ to src/ if needed
if [ -f "tests/driver.adb" ] && [ ! -f "src/driver.adb" ]; then
    mv tests/driver.adb src/driver.adb
    rmdir tests 2>/dev/null || true
fi

# Create directories
mkdir -p src bin obj

echo "✅ Alire crate '$PROJECT_NAME' initialized!"
echo ""
echo "To build:"
echo "  alr build"
echo ""
echo "To run:"
echo "  alr run"
