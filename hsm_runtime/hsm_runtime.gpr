library project HSM_Runtime is
   for Library_Name use "hsm_runtime";
   for Library_Dir use "lib";
   for Object_Dir use "obj";
   for Source_Dirs use ("src");

   for Library_Interface use
     ("HSM",
      "Utilities",
      "HSM.Machines",
      "Utilities.Tracing");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX",
         "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;

   package Install is
      for Artifacts (".") use ("src");
   end Install;
end HSM_Runtime;
